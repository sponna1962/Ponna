// PONNA.in — Database Schema
// Implements the finalized Project Requirements Document (v1.1)
// ORM: Prisma / PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  VIEWER_STAFF
}

model User {
  id             String    @id @default(uuid())
  // The canonical identity key going forward — one Firebase Auth user (one
  // uid) may have BOTH a Phone credential and a Google credential attached
  // via Firebase's own account-linking (linkWithPopup), which keeps the uid
  // unchanged. Login always resolves by uid first; phone/email below are
  // kept as convenient lookup fields and Profile display, never as the
  // primary key for "who is this". Nullable only for rows created before
  // this field existed — backfilled the next time that student logs in.
  firebaseUid    String?   @unique
  phone          String?   @unique
  email          String?   @unique
  name           String?
  preferredLang  Language  @default(TA)
  // Profile photo — auto-captured from the Google account's photo on first
  // Google sign-in (never overwritten by a later Google login once set, so
  // a manual upload here always wins going forward). Null for Phone-only
  // students until they upload one themselves.
  photoUrl       String?

  // Finalized Profile redesign — Personal Information section. All nullable
  // at the DB level (same pattern as district/city below): initial signup
  // stays minimal (name + phone/OTP only), these become REQUIRED only at
  // the application layer (isProfileComplete), gated the same way district/
  // city already were — never forced at signup, only when the student
  // tries to view Rank or pay for a plan.
  dateOfBirth    DateTime? // stored as a real date, never free text
  whatsappNumber String?

  // Profile completion fields (§ profile-completion requirement) — nullable
  // because initial signup is intentionally minimal (name + phone/OTP only).
  // Required only when the student tries to view Rank or pay for a plan.
  district           String?
  cityTownVillage    String?
  preparingFor       String[] @default([]) // superseded by the finalized Profile redesign (Education section below) — column kept, no longer read/written by the Profile page, so no data migration needed

  // Finalized Profile redesign — Education section. Deliberately just
  // enough to describe "where the student is right now" for FUTURE
  // personalization (explicitly not used to restrict exam access or drive
  // any recommendation logic yet — finalized requirement). Exactly one of
  // the three detail fields is meaningful, matching whichever
  // educationStatus was chosen; the other two stay null.
  educationStatus      EducationStatus?
  currentClass         String? // when educationStatus = SCHOOL_STUDENT
  courseOrDegree       String? // when educationStatus = COLLEGE_STUDENT
  yearOfStudy          String? // when educationStatus = COLLEGE_STUDENT
  highestQualification String? // when educationStatus = COMPLETED_STUDIES

  // Test/QA accounts (finalized requirement) — bypasses ALL quota
  // restrictions (free daily limit, paid cycle limit, plan expiry) and is
  // excluded from ranking calculations and student analytics, so QA
  // activity never pollutes real student data. Off by default; only Super
  // Admin can flip this from the admin panel (Students section).
  isTestAccount      Boolean  @default(false)

  createdAt      DateTime  @default(now())

  subscriptions      Subscription[]
  quizSessions       QuizSession[]
  answerHistory       UserQuestionHistory[]
  performanceSummary  UserPerformanceSummary[]
  practicePreference  StudentPracticePreference?

  @@index([phone])
  @@index([email])
}

enum EducationStatus {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  COMPLETED_STUDIES
}

// Practice Preference — Language + Exam Authority/Category/Sub-Category
// selections + Difficulty, set once by the student (mandatory before their
// first practice session) and reused for every future session until they
// explicitly change it via "Change Preferences". One row per student.
//
// `selections` is a JSON blob rather than relational join tables — the
// nested, variable-depth, multi-select shape (multiple Authorities, each
// with its own multiple Categories, each with its own multiple
// Sub-Categories) doesn't need relational integrity here; it only needs to
// be interpretable by allocation.service.ts when building a session. IDs
// referenced inside are stable Authority/Category/Sub-Category ids (never
// names, so renaming a Category elsewhere never breaks a saved preference).
//
// "All" is intentionally NEVER a stored id — it's a boolean flag at each
// level (allAuthorities / authority.allCategories / category.allSubCategories).
// This is what makes "All" dynamic: a student who chose "TNPSC → All
// Categories" automatically gets any Category added to TNPSC in the future,
// with no preference update needed (see allocation.service.ts).
//
// Shape of `selections`:
// {
//   allAuthorities: boolean,
//   authorities: [
//     {
//       authorityId: string,
//       allCategories: boolean,
//       categories: [
//         { categoryId: string, allSubCategories: boolean, subCategoryIds: string[] }
//       ]
//     }
//   ]
// }
model StudentPracticePreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  language   Language // pure content filter (§ finalized rule) — never tied to a specific Authority
  mode       QuizMode // Mixed / Medium / Hard — reused enum, no "Easy" option
  selections Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Internal staff accounts — separate from students, per §3 (multi-role admin access)
model StaffUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         StaffRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  createdBy    String?

  @@index([role])
}

// ─────────────────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS  (§5 Plans & Quota)
// ─────────────────────────────────────────────────────────

// Plans are now fully dynamic/admin-configurable (finalized requirement) —
// no hardcoded plan codes. A Plan's SCOPE (which exams it grants access to)
// is set exactly one of two ways:
//   - purposeId set  → covers the ENTIRE Purpose (e.g. Competitive /
//     Employment Plan covers TNPSC, UPSC, SSC, Railway... automatically,
//     including any new Authority added under that Purpose later — no
//     per-authority list to maintain)
//   - authorityScopes set (via PlanAuthorityScope) → covers only the
//     specific Authority(ies) linked (e.g. NEET Plan → NEET only; JEE Plan
//     → JEE Main + JEE Advanced, both linked to the same Plan; CLAT Plan →
//     CLAT only)
// Never both on the same Plan — enforced in the admin service layer (Prisma
// has no native XOR constraint). Exactly one Plan should ever be
// isFree=true — that one has neither scope (it's the fallback for any
// exam with no active paid Plan covering it) and uses dailyLimit instead
// of cycleDays.
model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  nameTa          String?
  regularPrice    Decimal? @db.Decimal(10, 2)
  // When set, this is the price actually charged and shown as the current
  // price (with regularPrice shown struck through alongside it) — a plain
  // admin-editable field, not a countdown timer. Clearing it (null) reverts
  // the plan to regularPrice with no other change needed.
  launchPrice     Decimal? @db.Decimal(10, 2)
  dailyLimit      Int?     // FREE plan only: 5/day. Null for all paid plans — no question-count quota of any kind (finalized requirement).
  cycleDays       Int?     // Paid plans: 365 (12 months from purchase/activation). Null for the FREE plan (no cycle concept, daily-only).
  active          Boolean  @default(true)
  isFree          Boolean  @default(false) // marks THE single global Free-practice fallback plan
  // Deliberate display order on the student Plans page (finalized
  // requirement — not database/alphabetical order). Admin/seed-set; the
  // frontend never hardcodes plan names to decide ordering, only sorts by
  // this number.
  sortOrder       Int      @default(0)

  purposeId       String?
  purpose         ExamPurpose? @relation(fields: [purposeId], references: [id])
  authorityScopes PlanAuthorityScope[]

  subscriptions   Subscription[]
}

// Join table: which specific Authority(ies) an exam-specific Plan covers.
// Many-to-many so a Plan can span more than one Authority (JEE Main +
// JEE Advanced under one JEE Plan) and, symmetrically, so the same
// Authority could in principle be included in more than one Plan (kept
// open for the future Premium Multi-Exam plan — not built yet, per
// finalized requirement, but this shape doesn't block it later).
model PlanAuthorityScope {
  id          String        @id @default(uuid())
  planId      String
  plan        Plan          @relation(fields: [planId], references: [id])
  authorityId String
  authority   ExamAuthority @relation(fields: [authorityId], references: [id])

  @@unique([planId, authorityId])
}

// One row per purchase cycle. Renewal is manual — a new row is created on
// each re-purchase. A student may hold several ACTIVE Subscriptions at once
// (finalized requirement — e.g. NEET Plan + TNTET Plan simultaneously);
// access for a given Authority is resolved at query time in Phase 2 by
// checking ALL of a student's active, unexpired Subscriptions' Plans for
// one whose scope covers that Authority — not by there being a single
// "the" active subscription.
model Subscription {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])

  cycleStart       DateTime  @default(now())
  cycleEnd         DateTime  // cycleStart + plan.cycleDays (365 for paid; far-future placeholder for the Free plan's single row per user)

  dailyUsedDate        DateTime? // Free plan's daily reset tracking only
  questionsUsedToday   Int   @default(0) // Free plan's 5/day counter only — paid plans never touch this (no quota, finalized requirement)

  razorpayPaymentId String? @unique // set on paid plans once payment is confirmed via webhook; used for idempotency on retried webhook deliveries

  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([cycleEnd])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

// ─────────────────────────────────────────────────────────
// EXAM TAXONOMY — Authority → Category → Sub-Category (optional)
// Replaces the earlier 2-level ExamType/ExamSubType entirely (no parallel
// systems). Fully dynamic: Super Admin can add new Authorities, Categories,
// and Sub-Categories from the admin panel at any time — nothing here is
// hardcoded at the schema level, only the initial seed data is.
// ─────────────────────────────────────────────────────────

// Exam Type/Purpose (finalized requirement) — the top grouping level above
// Authority. Different purposes must never mix: an "All" selected inside
// "Employment / Recruitment Exams" must never pull in NEET or Teacher
// Eligibility, which live under different purposes.
model ExamPurpose {
  id         String          @id @default(uuid())
  name       String          @unique // e.g. "Competitive / Employment Exams"
  nameTa     String?         // Tamil label, e.g. "போட்டி / வேலைவாய்ப்புத் தேர்வுகள்"
  // Finalized requirement — a saved Practice Preference is scoped to exactly
  // ONE Purpose, and within it: Competitive/Employment allows multiple
  // Authorities in one preference (e.g. TNPSC + UPSC together); Higher
  // Education/Entrance and Eligibility/Qualification allow only ONE
  // Authority (different entrance exams/eligibility tests have unrelated
  // syllabi and must never be mixed in a single practice track). When false,
  // the frontend Authority step becomes true single-selection and the "All
  // Authorities" option is hidden entirely — mixing would defeat the purpose.
  allowMultipleAuthorities Boolean @default(true)
  authorities ExamAuthority[]
  plans       Plan[] // whole-Purpose Annual Plans (e.g. Competitive / Employment Plan) — see Plan.purposeId
}

model ExamAuthority {
  id         String         @id @default(uuid())
  // Optional at the DB level (not required) — this avoids a "required
  // column added to a populated table" failure from `prisma db push` when
  // this field was introduced after Authorities already existed. seed.ts
  // backfills every pre-existing row on deploy, and every NEW Authority
  // created via the admin API always supplies one — so in practice this is
  // never actually null once the backfill has run.
  purposeId  String?
  purpose    ExamPurpose?   @relation(fields: [purposeId], references: [id])
  name       String         // TNPSC, UPSC, SSC, Railway / RRB, Banking, TNUSRB, TRB, NEET, Teacher Eligibility, Other

  // Authority-level UI configuration (finalized requirement §3-4) — both
  // default true so every pre-existing Authority behaves exactly as before
  // this migration; Super Admin adjusts per-Authority from the admin panel,
  // no code change or redeploy needed for a new exam's specific behaviour.
  allowAllCategories Boolean  @default(true) // show an "All" chip at the Category-selection step for this Authority?
  difficultyEnabled  Boolean  @default(true) // show the Difficulty step for this Authority? (false = practice is always "Mixed" for it — a filter mode, never stored as a Question.difficulty value)

  // Config-driven exception to a single-select Purpose (finalized
  // requirement): null = standalone, cannot combine with anything. Two
  // Authorities with the SAME non-null value may be selected together
  // within a Purpose that otherwise restricts to one Authority — e.g. JEE
  // Main + JEE Advanced both get selectionGroup: "JEE". This has no effect
  // in a Purpose where allowMultipleAuthorities is already true (Competitive
  // / Employment) — that Purpose already allows any combination. Super
  // Admin sets this from the admin panel; never hardcoded by exam name.
  selectionGroup String?

  categories ExamCategory[]
  questions  Question[]
  planScopes PlanAuthorityScope[] // exam-specific Annual Plans that cover this Authority (e.g. NEET Plan, JEE Plan)

  @@unique([purposeId, name])
}

model ExamCategory {
  id            String            @id @default(uuid())
  authorityId   String
  authority     ExamAuthority     @relation(fields: [authorityId], references: [id])
  name          String            // e.g. "Group Examinations", "Technical Services", "Civil Services"
  subCategories ExamSubCategory[]
  questions     Question[]

  @@unique([authorityId, name])
}

// A topic/subject-matter tag (History, Polity, General Science, Aptitude...) —
// deliberately flat (no hierarchy) and independent of Authority, since the
// same Subject applies across many exam authorities. Admin/staff type a
// Subject name directly on the Bulk Upload / Add Question forms; the
// backend finds-or-creates by name, so this list grows organically without
// a separate "manage Subjects" admin step.
model Subject {
  id        String     @id @default(uuid())
  name      String     @unique
  questions Question[]
}

model ExamSubCategory {
  id         String       @id @default(uuid())
  categoryId String
  category   ExamCategory @relation(fields: [categoryId], references: [id])
  name       String       // e.g. "Group I", "Group IV", "Preliminary"
  questions  Question[]

  @@unique([categoryId, name])
}

// ─────────────────────────────────────────────────────────
// QUESTIONS  (§6 Question Database)
// ─────────────────────────────────────────────────────────

enum Difficulty {
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum QuestionCategory {
  STANDARD
  CURRENT_AFFAIRS
}

enum Language {
  TA
  EN
}

// Where a question came from — every question carries this, and all
// questions live in ONE master bank regardless of source; this is metadata
// for filtering/search, never a separate table per source.
enum SourceType {
  PREVIOUS_EXAM
  BOOK
  ORIGINAL
  OTHER
}

model Question {
  id               String            @id @default(uuid())
  questionText     String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctOption    CorrectOption

  // Future-ready, optional (finalized requirement) — not required for the
  // current wave of previous-exam question uploads, so bulk imports never
  // need to supply these. Add per-question later, or gradually as original
  // questions are authored.
  explanationTa    String?
  explanationEn    String?

  language         Language
  // Nullable link so a TA/EN pair can later be treated as one logical question
  // without any schema change (§6.2 Tamil/English translation linking)
  translationGroupId String?

  // Authority → Category → Sub-Category (all optional at the DB level — "not
  // necessarily mandatory in every situation"; Category alone plus Exam Year
  // is a valid, complete classification, e.g. TNPSC → Group IV → 2024 with
  // no Sub-Category or Exam Name needed).
  authorityId    String?
  authority      ExamAuthority?    @relation(fields: [authorityId], references: [id])
  categoryId     String?
  examCategory   ExamCategory?     @relation(fields: [categoryId], references: [id])
  subCategoryId  String?
  subCategory    ExamSubCategory?  @relation(fields: [subCategoryId], references: [id])
  examName       String?           // free text, only when Category/Sub-Category aren't specific enough (e.g. "Assistant Public Prosecutor, Grade II")
  examYear       Int?              // mainly meaningful for PREVIOUS_EXAM source type

  // Subject (topic/subject-matter, e.g. History, Polity, General Science) —
  // deliberately separate from the Authority→Category→Sub-Category exam-tier
  // taxonomy above, since a Subject cuts across multiple exam authorities.
  // Optional, admin/staff-typed with autocomplete against existing Subjects
  // (find-or-create — no separate "add a Subject" admin step required).
  subjectId      String?
  subject        Subject?          @relation(fields: [subjectId], references: [id])

  // Source — admin/backend-only metadata, not shown to students in this version.
  sourceType     SourceType        @default(ORIGINAL)
  sourceName     String?           // e.g. "TNPSC Group IV Question Paper 2024"
  internalNotes  String?           // admin-only, never surfaced anywhere else

  difficulty       Difficulty?       // nullable until AI classification / admin sets it
  status           QuestionStatus    @default(DRAFT)
  category         QuestionCategory  @default(STANDARD) // Standard vs Current Affairs — unrelated to ExamCategory above, kept for §6.4 allocation logic
  relevanceDate    DateTime?         // set for CURRENT_AFFAIRS questions, drives the 90-day recency window (§6.4)

  contentHash      String            // duplicate detection
  sourceBatchId    String?           // which bulk upload this came from

  aiSuggestedDifficulty Difficulty?
  aiConfidence          Float?       // 0–100, drives auto-publish vs Needs Review queue (§7.3, §9)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  history          UserQuestionHistory[]
  sessionQuestions QuizSessionQuestion[]

  @@index([status, difficulty, category])
  @@index([contentHash])
  @@index([translationGroupId])
  @@index([category, relevanceDate])
  @@index([authorityId, categoryId, subCategoryId])
}

enum CorrectOption {
  A
  B
  C
  D
}

// ─────────────────────────────────────────────────────────
// QUIZ SESSIONS  (§4.3 Taking a Quiz — resilience to disconnection)
// ─────────────────────────────────────────────────────────

enum QuizMode {
  MIXED
  MEDIUM
  HARD
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model QuizSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  mode            QuizMode
  practiceLanguage String       @default("TA") // "TA" | "EN" | "BOTH" — chosen once at session start, fixed for the whole session
  totalQuestions  Int
  status          SessionStatus @default(IN_PROGRESS)

  startedAt       DateTime      @default(now())
  lastActivityAt  DateTime      @default(now())
  completedAt     DateTime?

  questions       QuizSessionQuestion[]

  @@index([userId, status])
  @@index([status, lastActivityAt]) // for the abandonment sweep job
}

model QuizSessionQuestion {
  id            String       @id @default(uuid())
  sessionId     String
  session       QuizSession  @relation(fields: [sessionId], references: [id])
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id])
  sequenceNumber Int

  answered      Boolean      @default(false)
  selectedOption CorrectOption?
  isCorrect     Boolean?
  answeredAt    DateTime?

  @@unique([sessionId, questionId])
  @@index([sessionId, sequenceNumber])
}

// Permanent record of every question a student has actually answered.
// Drives "unseen-first" allocation (§6.4) and performance rollups (§8).
// Abandoned/unanswered reserved questions are NOT written here — only answered ones.
model UserQuestionHistory {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  questionId      String
  question        Question   @relation(fields: [questionId], references: [id])
  difficulty      Difficulty // denormalized copy at answer-time, for fast bucket aggregation
  modeTakenIn     QuizMode
  answeredCorrectly Boolean
  answeredAt      DateTime   @default(now())

  @@unique([userId, questionId]) // one history row per (user, question) — repeats overwrite/upsert per repetition policy
  @@index([userId, difficulty])
  @@index([userId, answeredAt])
}

// ─────────────────────────────────────────────────────────
// PERFORMANCE & RANKING  (§8 Ranking System)
// ─────────────────────────────────────────────────────────

// One row per (user, bucket). Bucket OVERALL = Mixed rollup across all answers;
// MEDIUM/HARD = filtered by difficulty. Maintained incrementally on each answer
// submission so rank queries don't scan raw history (§8.1 Recalculation note).
model UserPerformanceSummary {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  bucket           PerformanceBucket
  questionsAnswered Int          @default(0)
  correctAnswers    Int          @default(0)
  averagePercent    Float        @default(0)
  rank              Int?         // null until eligibility threshold met (§8.1)
  updatedAt         DateTime     @updatedAt

  @@unique([userId, bucket])
  @@index([bucket, averagePercent])
}

enum PerformanceBucket {
  OVERALL
  MEDIUM
  HARD
}

// ─────────────────────────────────────────────────────────
// ADMIN-CONFIGURABLE SETTINGS  (§7.7, §8.1 — nothing hardcoded)
// ─────────────────────────────────────────────────────────

// Single-row (or keyed) settings table. Seed values match the launch defaults
// agreed in the requirements doc; every value here is editable from the admin panel.
model PlatformSettings {
  id                          String   @id @default("singleton")

  repetitionStrategy          String   @default("UNSEEN_FIRST_THEN_OLDEST") // configurable per §6.4
  repeatAfterDays             Int?     // used only if strategy = REPEAT_AFTER_DAYS

  caMaxFor5Q                  Int      @default(1)   // Current Affairs caps per session size, §6.4
  caMaxFor20Q                 Int      @default(2)
  caMaxFor50Q                 Int      @default(5)
  caRecencyWindowDays         Int      @default(90)   // §6.4

  aiConfidenceThreshold       Float    @default(85)   // §7.3 / §9
  rankingEligibilityMinQuestions Int   @default(50)   // §8.1

  sessionInactivityHours      Int      @default(48)   // abandonment window, §4.3 / §13

  updatedAt                   DateTime @updatedAt
}
