// PONNA.in — Database Schema
// Implements the finalized Project Requirements Document (v1.1)
// ORM: Prisma / PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  VIEWER_STAFF
}

model User {
  id             String    @id @default(uuid())
  // The canonical identity key going forward — one Firebase Auth user (one
  // uid) may have BOTH a Phone credential and a Google credential attached
  // via Firebase's own account-linking (linkWithPopup), which keeps the uid
  // unchanged. Login always resolves by uid first; phone/email below are
  // kept as convenient lookup fields and Profile display, never as the
  // primary key for "who is this". Nullable only for rows created before
  // this field existed — backfilled the next time that student logs in.
  firebaseUid    String?   @unique
  phone          String?   @unique
  email          String?   @unique
  name           String?
  preferredLang  Language  @default(TA)
  // Profile photo — auto-captured from the Google account's photo on first
  // Google sign-in (never overwritten by a later Google login once set, so
  // a manual upload here always wins going forward). Null for Phone-only
  // students until they upload one themselves.
  photoUrl       String?

  // Finalized Profile redesign — Personal Information section. All nullable
  // at the DB level (same pattern as district/city below): initial signup
  // stays minimal (name + phone/OTP only), these become REQUIRED only at
  // the application layer (isProfileComplete), gated the same way district/
  // city already were — never forced at signup, only when the student
  // tries to view Rank or pay for a plan.
  dateOfBirth    DateTime? // stored as a real date, never free text
  whatsappNumber String?

  // Profile completion fields (§ profile-completion requirement) — nullable
  // because initial signup is intentionally minimal (name + phone/OTP only).
  // Required only when the student tries to view Rank or pay for a plan.
  district           String?
  cityTownVillage    String?
  preparingFor       String[] @default([]) // superseded by the finalized Profile redesign (Education section below) — column kept, no longer read/written by the Profile page, so no data migration needed

  // Finalized Profile redesign — Education section. Deliberately just
  // enough to describe "where the student is right now" for FUTURE
  // personalization (explicitly not used to restrict exam access or drive
  // any recommendation logic yet — finalized requirement). Exactly one of
  // the three detail fields is meaningful, matching whichever
  // educationStatus was chosen; the other two stay null.
  educationStatus      EducationStatus?
  currentClass         String? // when educationStatus = SCHOOL_STUDENT
  courseOrDegree       String? // when educationStatus = COLLEGE_STUDENT
  yearOfStudy          String? // when educationStatus = COLLEGE_STUDENT
  highestQualification String? // when educationStatus = COMPLETED_STUDIES

  // Test/QA accounts (finalized requirement) — bypasses ALL quota
  // restrictions (free daily limit, paid cycle limit, plan expiry) and is
  // excluded from ranking calculations and student analytics, so QA
  // activity never pollutes real student data. Off by default; only Super
  // Admin can flip this from the admin panel (Students section).
  isTestAccount      Boolean  @default(false)

  // ── Anti-abuse controls for Paid Annual Plans (finalized requirement) ──
  // Daily cap on ACTUAL question attempts (not per-exam) for a paid/
  // covered selection — mirrors the Free plan's own daily-counter pattern,
  // just scoped to the User directly rather than a Subscription, since a
  // paid student may hold several Subscriptions across exams and this cap
  // is global across all of them. Deducted atomically at session start
  // (see quota.service.ts) so concurrent requests can't bypass it.
  dailyPaidQuestionsUsed Int       @default(0)
  dailyPaidQuestionsDate DateTime?

  // Single-active-session enforcement — embedded in every issued JWT;
  // requireStudentAuth rejects any token whose embedded version doesn't
  // match this CURRENT value. Incremented on every successful login,
  // which is exactly what invalidates whatever token was issued to any
  // other device.
  sessionVersion Int @default(0)

  // Suspicious-usage flag (finalized requirement) — flag-only, never an
  // automatic block/suspend. Set by the scheduled suspicious-usage sweep;
  // cleared only by a Super Admin from the Students admin page.
  flaggedSuspicious Boolean  @default(false)
  flaggedReason     String?
  flaggedAt         DateTime?

  // Simple heuristic inputs for the suspicious-usage sweep (see
  // anti-abuse.service.ts) — deliberately lightweight rather than a full
  // device/usage history log. totalDeviceRegistrations is a lifetime
  // counter (never decremented, even when a device is later removed) —
  // a normal student cycles through 1-2 phones a year; a much higher
  // count suggests active device churn/sharing. nearCapStreak counts
  // CONSECUTIVE days the 75/day paid cap was nearly/fully used.
  totalDeviceRegistrations Int @default(0)
  nearCapStreak            Int @default(0)

  // ── Free Preview: one-time-per-verified-phone (finalized requirement,
  // the standard rule for every account from launch — no existing users
  // to grandfather) ─────────────────────────────────────────────────────
  // Free Preview requires BOTH a verified phone (User.phone, which can
  // only ever be set via an actual Firebase Phone-OTP verification —
  // never manually typed, Profile shows it read-only) and an email, then
  // grants exactly 5 questions ONE TIME EVER — freePreviewQuestionsUsed
  // kept directly on User rather than a separate phone-keyed table:
  // `phone` is already @unique here, and Firebase itself resolves a
  // repeat verification of the same phone number back to this SAME User
  // row (see student-auth.service.ts's phone backfill branch) rather than
  // creating a second usable account — so "one phone = one User row,
  // ever" already holds structurally, and this counter is exactly
  // equivalent to a phone-keyed one without needing extra plumbing.
  freePreviewQuestionsUsed Int @default(0)

  // IP capture for the multi-signal abuse check (finalized requirement —
  // see anti-abuse.service.ts's checkNewSignupAbuse) — NEVER used alone to
  // block anything, only ever combined with device/account-creation-
  // pattern signals, and only ever flags for admin review. signupIp is
  // set once, at account creation; lastLoginIp updates on every login,
  // kept for admin visibility only (not itself a signal input).
  signupIp    String?
  lastLoginIp String?

  createdAt      DateTime  @default(now())

  subscriptions      Subscription[]
  quizSessions       QuizSession[]
  answerHistory       UserQuestionHistory[]
  performanceSummary  UserPerformanceSummary[]
  practicePreference  StudentPracticePreference?
  subjectTopicPreferences StudentSubjectTopicPreference[]
  devices             Device[]
  questionReports     QuestionReport[]
  dailyQuizAttempts   DailyQuizAttempt[]
  mistakeReviews      MistakeReview[]
  askPonnaConversations AskPonnaConversation[]

  @@index([phone])
  @@index([email])
}

// One row per device a student has logged in from — enforces the 2-device
// cap (finalized requirement). `deviceId` is a random id the CLIENT
// generates once and persists (browser localStorage) — the same value is
// sent on every login from that browser, so it's how we recognize "this is
// the same device again" versus "this is a new one." Not a hardware
// fingerprint (deliberately — those are unreliable and privacy-invasive);
// a student clearing their browser storage will look like a new device on
// next login, same as most consumer apps' device lists behave.
model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceId   String   // client-generated, persisted in localStorage
  label      String?  // e.g. a short user-agent summary, for the "My Devices" list
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

// Reported Question Errors (finalized requirement — content quality
// control) — a student-facing "Report an issue" on any question during
// practice. Deliberately simple: FLAG for admin review, never auto-hides
// or auto-disables the question — a single report could itself be
// mistaken, so a human always decides. Admin resolves from the Question
// ── Daily Quiz (finalized requirement) ─────────────────────────────────
// 10 current-affairs/news questions, published once daily, available for
// exactly 24 hours, paid-users-only. Deliberately COMPLETELY SEPARATE
// tables from QuizSession/QuizSessionQuestion/UserQuestionHistory/
// UserPerformanceSummary — never touches normal Practice's quota,
// allocation engine, no-repeat history, or Rank/Performance calculation.
//
// One row per question holds BOTH language versions directly (unlike the
// main Question bank's two-linked-rows model) — Tamil and English are
// explicitly "two versions of the same Daily Quiz," always uploaded and
// published together as a pair, never independently, so there's no need
// for the main bank's more flexible per-language-row structure here.
model DailyQuiz {
  id         String          @id @default(uuid())
  // Brain Challenge (finalized requirement) shares this exact model —
  // same 10-question/24-hour/one-attempt/paid-access structure — just a
  // different question theme (reasoning/logic/observation/analytical/
  // problem-solving instead of current-affairs). quizType is what lets
  // both exist for the SAME calendar date as two independent rows,
  // reflected in the compound unique constraint below (quizDate alone is
  // no longer unique on its own).
  quizType   DailyQuizType   @default(DAILY_QUIZ)
  quizDate   DateTime // the IST calendar day this quiz is FOR (date-only, time component ignored)
  publishAt  DateTime // exact go-live instant
  expiresAt  DateTime // exact instant it stops being accessible — always publishAt + 24h
  // Status is a display/admin convenience only, kept in sync by the
  // scheduled sweep — the student-facing API NEVER trusts this field
  // alone, it always re-checks publishAt/expiresAt live (finalized
  // requirement — a cron delay must never make an expired quiz
  // accessible, or a not-yet-due one accessible early).
  status     DailyQuizStatus @default(DRAFT)
  createdAt  DateTime        @default(now())

  questions  DailyQuizQuestion[]
  attempts   DailyQuizAttempt[]

  @@unique([quizDate, quizType])
}

enum DailyQuizType {
  DAILY_QUIZ // current-affairs/news questions
  BRAIN_CHALLENGE // reasoning, logical thinking, observation, analytical thinking, basic problem-solving
}

enum DailyQuizStatus {
  DRAFT // uploaded + validated, not yet scheduled
  SCHEDULED // publishAt set, waiting for that instant
  PUBLISHED // live now
  EXPIRED // past expiresAt
}

model DailyQuizQuestion {
  id             String    @id @default(uuid())
  dailyQuizId    String
  dailyQuiz      DailyQuiz @relation(fields: [dailyQuizId], references: [id])
  sequenceNumber Int // 1-10, display/answer order

  questionTextTa String
  optionATa      String
  optionBTa      String
  optionCTa      String
  optionDTa      String
  explanationTa  String // mandatory (finalized requirement) — immediate result+explanation is core to this feature

  questionTextEn String
  optionAEn      String
  optionBEn      String
  optionCEn      String
  optionDEn      String
  explanationEn  String // mandatory (finalized requirement)

  correctOption  CorrectOption // same position (A/B/C/D) in both language option sets

  answers        DailyQuizAnswer[]

  @@unique([dailyQuizId, sequenceNumber])
}

// One per (student, quiz) — enforces "only one attempt per day" and "the
// chosen language is locked once started" (finalized requirement) purely
// via the unique constraint + never accepting a language change once a
// row exists.
model DailyQuizAttempt {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  dailyQuizId String
  dailyQuiz   DailyQuiz  @relation(fields: [dailyQuizId], references: [id])
  language    Language // locked at creation, never changed
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  score       Int? // correct-answer count, set once completedAt is set

  answers     DailyQuizAnswer[]

  @@unique([userId, dailyQuizId])
}

model DailyQuizAnswer {
  id             String            @id @default(uuid())
  attemptId      String
  attempt        DailyQuizAttempt  @relation(fields: [attemptId], references: [id])
  questionId     String
  question       DailyQuizQuestion @relation(fields: [questionId], references: [id])
  selectedOption CorrectOption
  isCorrect      Boolean
  answeredAt     DateTime          @default(now())

  @@unique([attemptId, questionId]) // one answer per question per attempt — the resume mechanism's "already answered" check
}

// Reports page, which can also jump straight into editing the question.
model QuestionReport {
  id         String               @id @default(uuid())
  questionId String
  question   Question             @relation(fields: [questionId], references: [id])
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  reason     QuestionReportReason
  comment    String?
  status     QuestionReportStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  @@index([questionId])
  @@index([status])
}

enum QuestionReportReason {
  WRONG_ANSWER
  UNCLEAR_OR_TYPO
  WRONG_OPTIONS
  OTHER
}

enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EducationStatus {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  COMPLETED_STUDIES
}

// Practice Preference — Language + Exam Authority/Category/Sub-Category
// selections + Difficulty, set once by the student (mandatory before their
// first practice session) and reused for every future session until they
// explicitly change it via "Change Preferences". One row per student.
//
// `selections` is a JSON blob rather than relational join tables — the
// nested, variable-depth, multi-select shape (multiple Authorities, each
// with its own multiple Categories, each with its own multiple
// Sub-Categories) doesn't need relational integrity here; it only needs to
// be interpretable by allocation.service.ts when building a session. IDs
// referenced inside are stable Authority/Category/Sub-Category ids (never
// names, so renaming a Category elsewhere never breaks a saved preference).
//
// "All" is intentionally NEVER a stored id — it's a boolean flag at each
// level (allAuthorities / authority.allCategories / category.allSubCategories).
// This is what makes "All" dynamic: a student who chose "TNPSC → All
// Categories" automatically gets any Category added to TNPSC in the future,
// with no preference update needed (see allocation.service.ts).
//
// Shape of `selections`:
// {
//   allAuthorities: boolean,
//   authorities: [
//     {
//       authorityId: string,
//       allCategories: boolean,
//       categories: [
//         { categoryId: string, allSubCategories: boolean, subCategoryIds: string[] }
//       ]
//     }
//   ]
// }
model StudentPracticePreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  language   Language // pure content filter (§ finalized rule) — never tied to a specific Authority
  mode       QuizMode // Mixed / Medium / Hard — reused enum, no "Easy" option
  selections Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Student Subject & Topic Preference (finalized requirement — Phase 1
// of "TNPSC Exam -> Subject -> Topic Preference") ──────────────────────
// One row per (student, exam) — a student can hold a saved preference for
// more than one TNPSC exam even though only one is their currently-active
// Practice selection. subjectIds/topicIds are plain scalar arrays (not a
// join table) since this is an OPTIONAL preference list, not data needing
// strict relational integrity — an id referencing a since-renamed/removed
// SyllabusSubject or SyllabusTopic is simply ignored by the (future)
// allocation logic rather than causing an error.
//
// STAGE 1 ONLY (finalized requirement — "First implement and test the
// Student Subject & Topic Preference system. Then implement the
// preference-based question allocation."): this model and its routes are
// purely storage + a student-facing picker UI. Nothing in
// allocation.service.ts/quota.service.ts reads from this table yet — a
// saved preference has NO effect on which questions a student receives
// until Stage 2 is explicitly implemented. Existing strict rules (Exam,
// Subject collision-free tagging, Language, Difficulty, No-Repeat) are
// completely untouched by this model's existence.
model StudentSubjectTopicPreference {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  subCategoryId String          // which exam this preference is FOR (e.g. "Group I")
  subCategory   ExamSubCategory @relation(fields: [subCategoryId], references: [id])
  subjectIds    String[]        // selected SyllabusSubject ids — empty means no subject-level preference
  topicIds      String[]        // selected SyllabusTopic ids — finer-grained than subjectIds; empty means no topic-level preference
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())

  @@unique([userId, subCategoryId])
}

// Internal staff accounts — separate from students, per §3 (multi-role admin access)
model StaffUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         StaffRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  createdBy    String?

  @@index([role])
}

// ─────────────────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS  (§5 Plans & Quota)
// ─────────────────────────────────────────────────────────

// Plans are now fully dynamic/admin-configurable (finalized requirement) —
// no hardcoded plan codes. A Plan's SCOPE (which exams it grants access to)
// is set exactly one of two ways:
//   - purposeId set  → covers the ENTIRE Purpose (e.g. Competitive /
//     Employment Plan covers TNPSC, UPSC, SSC, Railway... automatically,
//     including any new Authority added under that Purpose later — no
//     per-authority list to maintain)
//   - authorityScopes set (via PlanAuthorityScope) → covers only the
//     specific Authority(ies) linked (e.g. NEET Plan → NEET only; JEE Plan
//     → JEE Main + JEE Advanced, both linked to the same Plan; CLAT Plan →
//     CLAT only)
// Never both on the same Plan — enforced in the admin service layer (Prisma
// has no native XOR constraint). Exactly one Plan should ever be
// isFree=true — that one has neither scope (it's the fallback for any
// exam with no active paid Plan covering it) and uses dailyLimit instead
// of cycleDays.
model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  nameTa          String?
  regularPrice    Decimal? @db.Decimal(10, 2)
  // When set, this is the price actually charged and shown as the current
  // price (with regularPrice shown struck through alongside it) — a plain
  // admin-editable field, not a countdown timer. Clearing it (null) reverts
  // the plan to regularPrice with no other change needed.
  launchPrice     Decimal? @db.Decimal(10, 2)
  dailyLimit      Int?     // FREE plan only: 5/day. Null for all paid plans — no question-count quota of any kind (finalized requirement).
  cycleDays       Int?     // Paid plans: 365 (12 months from purchase/activation). Null for the FREE plan (no cycle concept, daily-only).
  active          Boolean  @default(true)
  isFree          Boolean  @default(false) // marks THE single global Free-practice fallback plan
  // Deliberate display order on the student Plans page (finalized
  // requirement — not database/alphabetical order). Admin/seed-set; the
  // frontend never hardcodes plan names to decide ordering, only sorts by
  // this number.
  sortOrder       Int      @default(0)

  purposeId       String?
  purpose         ExamPurpose? @relation(fields: [purposeId], references: [id])
  authorityScopes PlanAuthorityScope[]

  subscriptions   Subscription[]
}

// Join table: which specific Authority(ies) an exam-specific Plan covers.
// Many-to-many so a Plan can span more than one Authority (JEE Main +
// JEE Advanced under one JEE Plan) and, symmetrically, so the same
// Authority could in principle be included in more than one Plan (kept
// open for the future Premium Multi-Exam plan — not built yet, per
// finalized requirement, but this shape doesn't block it later).
model PlanAuthorityScope {
  id          String        @id @default(uuid())
  planId      String
  plan        Plan          @relation(fields: [planId], references: [id])
  authorityId String
  authority   ExamAuthority @relation(fields: [authorityId], references: [id])

  @@unique([planId, authorityId])
}

// Additional-Authority tags for Original/Book/Other questions — see
// Question.authorityTags for the full rationale. Many-to-many: one
// question can tag several Authorities, and (symmetrically, though not
// currently exercised any other way) one Authority can be tagged onto many
// questions.
// Additional taxonomy tags for Original/Book/Other questions — see
// Question.authorityTags for the full rationale. Each row is a full
// Authority [+ Category [+ Sub-Category]] triple this question ALSO
// belongs to, beyond its primary classification — matching the exact same
// granularity as the primary metadata step (e.g. a TNPSC General Studies
// question tagged once per Group: TNPSC/Group Examinations/Group I,
// TNPSC/Group Examinations/Group II, ... one row per Group). categoryId/
// subCategoryId are nullable: a tag with only authorityId matches "All
// Categories" selections for that Authority; one with categoryId set
// (subCategoryId null) matches any Sub-Category selection under that
// Category — same superset semantics as the primary authorityId/
// categoryId/subCategoryId fields on Question itself.
model QuestionTaxonomyTag {
  id            String            @id @default(uuid())
  questionId    String
  question      Question          @relation(fields: [questionId], references: [id])
  authorityId   String
  authority     ExamAuthority     @relation(fields: [authorityId], references: [id])
  categoryId    String?
  category      ExamCategory?     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   ExamSubCategory?  @relation(fields: [subCategoryId], references: [id])
}

// One row per purchase cycle. Renewal is manual — a new row is created on
// each re-purchase. A student may hold several ACTIVE Subscriptions at once
// (finalized requirement — e.g. NEET Plan + TNTET Plan simultaneously);
// access for a given Authority is resolved at query time in Phase 2 by
// checking ALL of a student's active, unexpired Subscriptions' Plans for
// one whose scope covers that Authority — not by there being a single
// "the" active subscription.
model Subscription {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])

  cycleStart       DateTime  @default(now())
  cycleEnd         DateTime  // cycleStart + plan.cycleDays (365 for paid; far-future placeholder for the Free plan's single row per user)

  dailyUsedDate        DateTime? // Free plan's daily reset tracking only
  questionsUsedToday   Int   @default(0) // Free plan's 5/day counter only — paid plans never touch this (no quota, finalized requirement)

  razorpayPaymentId String? @unique // set on paid plans once payment is confirmed via webhook; used for idempotency on retried webhook deliveries

  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([cycleEnd])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

// ─────────────────────────────────────────────────────────
// EXAM TAXONOMY — Authority → Category → Sub-Category (optional)
// Replaces the earlier 2-level ExamType/ExamSubType entirely (no parallel
// systems). Fully dynamic: Super Admin can add new Authorities, Categories,
// and Sub-Categories from the admin panel at any time — nothing here is
// hardcoded at the schema level, only the initial seed data is.
// ─────────────────────────────────────────────────────────

// Exam Type/Purpose (finalized requirement) — the top grouping level above
// Authority. Different purposes must never mix: an "All" selected inside
// "Employment / Recruitment Exams" must never pull in NEET or Teacher
// Eligibility, which live under different purposes.
model ExamPurpose {
  id         String          @id @default(uuid())
  name       String          @unique // e.g. "Competitive / Employment Exams"
  nameTa     String?         // Tamil label, e.g. "போட்டி / வேலைவாய்ப்புத் தேர்வுகள்"
  // Finalized requirement — a saved Practice Preference is scoped to exactly
  // ONE Purpose, and within it: Competitive/Employment allows multiple
  // Authorities in one preference (e.g. TNPSC + UPSC together); Higher
  // Education/Entrance and Eligibility/Qualification allow only ONE
  // Authority (different entrance exams/eligibility tests have unrelated
  // syllabi and must never be mixed in a single practice track). When false,
  // the frontend Authority step becomes true single-selection and the "All
  // Authorities" option is hidden entirely — mixing would defeat the purpose.
  allowMultipleAuthorities Boolean @default(true)
  // Student-facing launch visibility (finalized requirement, Sept 15 launch)
  // — false hides this ENTIRE Purpose (and everything under it) from the
  // student-facing taxonomy/Practice Setup, while the Admin panel continues
  // to show and manage it normally. Default true so every pre-existing
  // Purpose stays visible unless explicitly hidden. This is purely a
  // display/selection gate, not a deletion — questions, Authorities,
  // Categories, and Sub-Categories underneath are entirely untouched and
  // can keep being prepared from the admin side regardless of this flag.
  studentVisible Boolean @default(true)
  authorities ExamAuthority[]
  plans       Plan[] // whole-Purpose Annual Plans (e.g. Competitive / Employment Plan) — see Plan.purposeId
}

model ExamAuthority {
  id         String         @id @default(uuid())
  // Optional at the DB level (not required) — this avoids a "required
  // column added to a populated table" failure from `prisma db push` when
  // this field was introduced after Authorities already existed. seed.ts
  // backfills every pre-existing row on deploy, and every NEW Authority
  // created via the admin API always supplies one — so in practice this is
  // never actually null once the backfill has run.
  purposeId  String?
  purpose    ExamPurpose?   @relation(fields: [purposeId], references: [id])
  name       String         // TNPSC, UPSC, SSC, Railway / RRB, Banking, TNUSRB, TRB, NEET, Teacher Eligibility, Other

  // Authority-level UI configuration (finalized requirement §3-4) — both
  // default true so every pre-existing Authority behaves exactly as before
  // this migration; Super Admin adjusts per-Authority from the admin panel,
  // no code change or redeploy needed for a new exam's specific behaviour.
  allowAllCategories Boolean  @default(true) // show an "All" chip at the Category-selection step for this Authority?
  difficultyEnabled  Boolean  @default(true) // show the Difficulty step for this Authority? (false = practice is always "Mixed" for it — a filter mode, never stored as a Question.difficulty value)

  // Config-driven exception to a single-select Purpose (finalized
  // requirement): null = standalone, cannot combine with anything. Two
  // Authorities with the SAME non-null value may be selected together
  // within a Purpose that otherwise restricts to one Authority — e.g. JEE
  // Main + JEE Advanced both get selectionGroup: "JEE". This has no effect
  // in a Purpose where allowMultipleAuthorities is already true (Competitive
  // / Employment) — that Purpose already allows any combination. Super
  // Admin sets this from the admin panel; never hardcoded by exam name.
  selectionGroup String?
  // Student-facing launch visibility (finalized requirement, Sept 15
  // launch) — false hides just this ONE Authority from the student-facing
  // taxonomy/Practice Setup, even when its Purpose IS visible (e.g. TNPSC
  // visible, UPSC hidden, both under the same visible Competitive/
  // Employment Purpose). Same display/selection-only semantics as
  // ExamPurpose.studentVisible above — never touches this Authority's
  // Categories, Sub-Categories, or Questions, all of which remain fully
  // manageable from the admin side.
  studentVisible Boolean @default(true)

  categories ExamCategory[]
  questions  Question[]
  planScopes PlanAuthorityScope[] // exam-specific Annual Plans that cover this Authority (e.g. NEET Plan, JEE Plan)
  questionTags QuestionTaxonomyTag[] // Original/Book/Other questions ALSO tagged as relevant here, beyond their primary Authority

  @@unique([purposeId, name])
}

model ExamCategory {
  id            String            @id @default(uuid())
  authorityId   String
  authority     ExamAuthority     @relation(fields: [authorityId], references: [id])
  name          String            // e.g. "Group Examinations", "Technical Services", "Civil Services"
  subCategories ExamSubCategory[]
  questions     Question[]
  taxonomyTags  QuestionTaxonomyTag[]

  @@unique([authorityId, name])
}

// A topic/subject-matter tag (History, Polity, General Science, Aptitude...) —
// deliberately flat (no hierarchy) and independent of Authority, since the
// same Subject applies across many exam authorities. Admin/staff type a
// Subject name directly on the Bulk Upload / Add Question forms; the
// backend finds-or-creates by name, so this list grows organically without
// a separate "manage Subjects" admin step.
model Subject {
  id        String     @id @default(uuid())
  name      String     @unique
  questions Question[]
}

model ExamSubCategory {
  id         String       @id @default(uuid())
  categoryId String
  category   ExamCategory @relation(fields: [categoryId], references: [id])
  name       String       // e.g. "Group I", "Group IV", "Preliminary"
  questions  Question[]
  taxonomyTags QuestionTaxonomyTag[]
  syllabusSubjects SyllabusSubject[]
  subjectTopicPreferences StudentSubjectTopicPreference[]
  // Student-facing launch visibility (finalized requirement — same
  // display/selection-only gate already used on ExamAuthority/ExamPurpose,
  // extended down to this level) — hides a Sub-Category that isn't an
  // officially-defined standalone TNPSC exam (verified against TNPSC's
  // own published Scheme of Examination) from student-facing Practice
  // Setup, while the admin panel keeps showing and managing it normally.
  // Never a deletion — data stays intact for whenever it's confirmed.
  studentVisible Boolean @default(true)

  @@unique([categoryId, name])
}

// ── Subject & Topic Preference (finalized requirement — TNPSC Subject/
// Topic Preference System) ──────────────────────────────────────────────
// Named SyllabusSubject/SyllabusTopic — deliberately distinct from the
// existing flat Subject model above (a free-text tag on Question, shared
// across every exam authority, e.g. "History", "Aptitude"). THIS
// hierarchy is a completely different concept: the official SYLLABUS
// structure of one specific exam, scoped to ONE ExamSubCategory (i.e. one
// specific exam — "Group I", "Group IV", etc.), not shared across exams —
// each TNPSC Group's own official syllabus gets its own independent
// Subject -> Topic tree, per explicit instruction ("separately for each
// examination rather than using one common subject list"). Purely a
// MASTER STRUCTURE for now — no student-preference or allocation-
// weighting wiring yet (finalized requirement: "We will then connect...
// later"), so this doesn't touch quota.service.ts/allocation.service.ts/
// PracticePreference in any way.
model SyllabusSubject {
  id            String           @id @default(uuid())
  subCategoryId String
  subCategory   ExamSubCategory  @relation(fields: [subCategoryId], references: [id])
  name          String           // e.g. "General Studies", "General Tamil / General English", "Aptitude & Mental Ability"
  sortOrder     Int              @default(0)
  topics        SyllabusTopic[]

  @@unique([subCategoryId, name])
}

model SyllabusTopic {
  id        String          @id @default(uuid())
  subjectId String
  subject   SyllabusSubject @relation(fields: [subjectId], references: [id])
  name      String          // e.g. "Modern History of India", "Geography of Tamil Nadu"
  sortOrder Int             @default(0)
  questions Question[]

  @@unique([subjectId, name])
}

// ─────────────────────────────────────────────────────────
// QUESTIONS  (§6 Question Database)
// ─────────────────────────────────────────────────────────

enum Difficulty {
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum QuestionCategory {
  STANDARD
  CURRENT_AFFAIRS
}

enum Language {
  TA
  EN
}

// Where a question came from — every question carries this, and all
// questions live in ONE master bank regardless of source; this is metadata
// for filtering/search, never a separate table per source.
enum SourceType {
  PREVIOUS_EXAM
  BOOK
  ORIGINAL
  OTHER
}

model Question {
  id               String            @id @default(uuid())
  questionText     String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctOption    CorrectOption

  // Future-ready, optional (finalized requirement) — not required for the
  // current wave of previous-exam question uploads, so bulk imports never
  // need to supply these. Add per-question later, or gradually as original
  // questions are authored.
  explanationTa    String?
  explanationEn    String?

  language         Language
  // Nullable link so a TA/EN pair can later be treated as one logical question
  // without any schema change (§6.2 Tamil/English translation linking)
  translationGroupId String?

  // Authority → Category → Sub-Category (all optional at the DB level — "not
  // necessarily mandatory in every situation"; Category alone plus Exam Year
  // is a valid, complete classification, e.g. TNPSC → Group IV → 2024 with
  // no Sub-Category or Exam Name needed).
  authorityId    String?
  authority      ExamAuthority?    @relation(fields: [authorityId], references: [id])
  categoryId     String?
  examCategory   ExamCategory?     @relation(fields: [categoryId], references: [id])
  subCategoryId  String?
  subCategory    ExamSubCategory?  @relation(fields: [subCategoryId], references: [id])
  examName       String?           // free text, only when Category/Sub-Category aren't specific enough (e.g. "Assistant Public Prosecutor, Grade II")
  examYear       Int?              // mainly meaningful for PREVIOUS_EXAM source type

  // Additional Authorities this question ALSO applies to, beyond the
  // primary authorityId above — for Original/Book/Other source-type
  // questions (General Knowledge, Aptitude, English...) that genuinely
  // benefit students preparing for SEVERAL exams at once, not just one
  // (finalized requirement). Previous Exam questions never use this — they
  // stay tied to the one authorityId their source paper belongs to.
  // Deliberately additive: authorityId/categoryId/subCategoryId above
  // remain the question's PRIMARY classification (used everywhere for
  // admin display/stats); this only WIDENS which practice sessions can
  // also surface it, via the allocation engine's OR match — see
  // practice-preference.service.ts's resolveTaxonomyFilter.
  authorityTags  QuestionTaxonomyTag[]
  reports        QuestionReport[]
  // Optional link to the Subject & Topic Preference master structure
  // (finalized requirement — groundwork for Stage 2, "preference-based
  // question allocation"). Nullable — the vast majority of existing
  // questions have no topic tag yet; admin tags them progressively via
  // the Question edit/Bulk Upload flow. NOT read by allocation.service.ts
  // or quota.service.ts yet — Stage 1 is storage + UI only, this field
  // has zero effect on which questions a student receives until Stage 2
  // is explicitly implemented.
  syllabusTopicId String?
  syllabusTopic   SyllabusTopic? @relation(fields: [syllabusTopicId], references: [id])

  // Subject (topic/subject-matter, e.g. History, Polity, General Science) —
  // deliberately separate from the Authority→Category→Sub-Category exam-tier
  // taxonomy above, since a Subject cuts across multiple exam authorities.
  // Optional, admin/staff-typed with autocomplete against existing Subjects
  // (find-or-create — no separate "add a Subject" admin step required).
  subjectId      String?
  subject        Subject?          @relation(fields: [subjectId], references: [id])

  // Source — admin/backend-only metadata, not shown to students in this version.
  sourceType     SourceType        @default(ORIGINAL)
  sourceName     String?           // e.g. "TNPSC Group IV Question Paper 2024"
  internalNotes  String?           // admin-only, never surfaced anywhere else

  difficulty       Difficulty?       // nullable until AI classification / admin sets it
  status           QuestionStatus    @default(DRAFT)
  category         QuestionCategory  @default(STANDARD) // Standard vs Current Affairs — unrelated to ExamCategory above, kept for §6.4 allocation logic
  relevanceDate    DateTime?         // set for CURRENT_AFFAIRS questions, drives the 90-day recency window (§6.4)

  contentHash      String            // duplicate detection
  sourceBatchId    String?           // which bulk upload this came from

  aiSuggestedDifficulty Difficulty?
  aiConfidence          Float?       // 0–100, drives auto-publish vs Needs Review queue (§7.3, §9)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  history          UserQuestionHistory[]
  sessionQuestions QuizSessionQuestion[]
  mistakeReviews   MistakeReview[]

  @@index([status, difficulty, category])
  @@index([contentHash])
  @@index([translationGroupId])
  @@index([category, relevanceDate])
  @@index([authorityId, categoryId, subCategoryId])
}

enum CorrectOption {
  A
  B
  C
  D
}

// ─────────────────────────────────────────────────────────
// QUIZ SESSIONS  (§4.3 Taking a Quiz — resilience to disconnection)
// ─────────────────────────────────────────────────────────

enum QuizMode {
  MIXED
  MEDIUM
  HARD
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model QuizSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  mode            QuizMode
  practiceLanguage String       @default("TA") // "TA" | "EN" | "BOTH" — chosen once at session start, fixed for the whole session
  totalQuestions  Int
  status          SessionStatus @default(IN_PROGRESS)

  startedAt       DateTime      @default(now())
  lastActivityAt  DateTime      @default(now())
  completedAt     DateTime?

  questions       QuizSessionQuestion[]

  @@index([userId, status])
  @@index([status, lastActivityAt]) // for the abandonment sweep job
}

model QuizSessionQuestion {
  id            String       @id @default(uuid())
  sessionId     String
  session       QuizSession  @relation(fields: [sessionId], references: [id])
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id])
  sequenceNumber Int

  answered      Boolean      @default(false)
  selectedOption CorrectOption?
  isCorrect     Boolean?
  answeredAt    DateTime?

  @@unique([sessionId, questionId])
  @@index([sessionId, sequenceNumber])
}

// Permanent record of every question a student has actually answered.
// ── Review Mistakes (finalized requirement) — a REVISION flow, strictly
// separate from normal Practice's UserQuestionHistory/performance/rank/
// quota/Subject-Preference-allocation. One row per (student, question)
// ever answered wrong in normal Practice (created as a side-effect of
// session.service.ts's submitAnswer, never touched by Review Mistakes
// itself going the other way) — deduplicated by the unique constraint, so
// a question can never appear twice in the list. status flips to
// CORRECTED once the student successfully re-answers it here; a further
// wrong re-attempt here leaves it PENDING. Review attempts recorded here
// NEVER write to UserQuestionHistory, ranking, quota, or
// StudentSubjectTopicPreference-driven allocation — this table is the
// complete, sealed record of the revision flow.
enum MistakeReviewStatus {
  PENDING
  CORRECTED
}

// ── Ask Ponna — Personal AI Study & Exam Assistant (finalized requirement,
// Specification v3, Phase 1) ────────────────────────────────────────────
// Model-Agnostic Architecture is BINDING (Spec v3 §1.1-1.6): these two
// tables store PLAIN TEXT conversation content only — never a
// provider-specific response object (§1.4) — so history stays fully
// readable regardless of which provider generated it or which is active
// later. Every table in this schema outside these two remains completely
// unaware that Ask Ponna or any AI provider exists (§1.1) — no core
// system (Question, UserQuestionHistory, UserPerformanceSummary,
// MistakeReview, SyllabusSubject/Topic, ranking, quota, Subject
// Preference, No-Repeat) is touched by anything in this section.
model AskPonnaConversation {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  title     String?
  messages  AskPonnaMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum AskPonnaMessageRole {
  USER
  ASSISTANT
}

model AskPonnaMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   AskPonnaConversation @relation(fields: [conversationId], references: [id])
  role           AskPonnaMessageRole
  content        String               // plain text only — never a provider-specific object (§1.4)
  toolCallsUsed  Json?                // audit trail: which Tool Layer functions were called, never raw provider response shapes
  createdAt      DateTime             @default(now())
}

model MistakeReview {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  questionId     String
  question       Question            @relation(fields: [questionId], references: [id])
  status         MistakeReviewStatus @default(PENDING)
  lastReviewedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, questionId])
}

// Drives "unseen-first" allocation (§6.4) and performance rollups (§8).
// Abandoned/unanswered reserved questions are NOT written here — only answered ones.
model UserQuestionHistory {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  questionId      String
  question        Question   @relation(fields: [questionId], references: [id])
  difficulty      Difficulty // denormalized copy at answer-time, for fast bucket aggregation
  modeTakenIn     QuizMode
  answeredCorrectly Boolean
  answeredAt      DateTime   @default(now())

  @@unique([userId, questionId]) // one history row per (user, question) — repeats overwrite/upsert per repetition policy
  @@index([userId, difficulty])
  @@index([userId, answeredAt])
}

// ─────────────────────────────────────────────────────────
// PERFORMANCE & RANKING  (§8 Ranking System)
// ─────────────────────────────────────────────────────────

// One row per (user, bucket). Bucket OVERALL = Mixed rollup across all answers;
// MEDIUM/HARD = filtered by difficulty. Maintained incrementally on each answer
// submission so rank queries don't scan raw history (§8.1 Recalculation note).
model UserPerformanceSummary {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  bucket           PerformanceBucket
  questionsAnswered Int          @default(0)
  correctAnswers    Int          @default(0)
  averagePercent    Float        @default(0)
  rank              Int?         // null until eligibility threshold met (§8.1)
  updatedAt         DateTime     @updatedAt

  @@unique([userId, bucket])
  @@index([bucket, averagePercent])
}

enum PerformanceBucket {
  OVERALL
  MEDIUM
  HARD
}

// ─────────────────────────────────────────────────────────
// ADMIN-CONFIGURABLE SETTINGS  (§7.7, §8.1 — nothing hardcoded)
// ─────────────────────────────────────────────────────────

// Single-row (or keyed) settings table. Seed values match the launch defaults
// agreed in the requirements doc; every value here is editable from the admin panel.
model PlatformSettings {
  id                          String   @id @default("singleton")

  repetitionStrategy          String   @default("UNSEEN_FIRST_THEN_OLDEST") // configurable per §6.4
  repeatAfterDays             Int?     // used only if strategy = REPEAT_AFTER_DAYS

  caMaxFor5Q                  Int      @default(1)   // Current Affairs caps per session size, §6.4
  caMaxFor20Q                 Int      @default(2)
  caMaxFor50Q                 Int      @default(5)
  caRecencyWindowDays         Int      @default(90)   // §6.4

  aiConfidenceThreshold       Float    @default(85)   // §7.3 / §9
  rankingEligibilityMinQuestions Int   @default(50)   // §8.1

  sessionInactivityHours      Int      @default(48)   // abandonment window, §4.3 / §13

  // One-time marker (finalized requirement, Sept 15 launch) — guards the
  // seed script's launch-visibility defaults (hide every Authority except
  // TNPSC/TNTET, hide Higher Education/Entrance entirely) so they apply
  // exactly ONCE. Without this, a future admin re-enabling an exam via the
  // Admin Taxonomy page's "Visible to students" toggle would get silently
  // reverted back to hidden on the next deploy, since seed.ts runs on
  // every deploy.
  launchVisibilityApplied    Boolean  @default(false)

  // One-time marker (finalized requirement) — guards the seed script's
  // TNPSC exam-group visibility cleanup (hiding Group V/VII/VIII, which
  // aren't confirmed as officially-defined standalone TNPSC exams
  // against TNPSC's own published Scheme of Examination, while adding
  // Group I-A and Group V-A as the correctly-named official ones) so it
  // applies exactly once and never fights a future admin re-enabling one
  // of these via the Exam Taxonomy page's "Visible to students" toggle.
  tnpscGroupsVisibilityCleanupApplied Boolean @default(false)

  // Daily Quiz (finalized requirement) — dailyQuizEnabled is the "Coming
  // Soon" toggle: false shows the placeholder page to students regardless
  // of whether any DailyQuiz rows exist yet, so the admin side can be
  // built/tested well before the student-facing feature goes live, with
  // no deploy needed to flip it on later (same pattern as
  // launchVisibilityApplied's studentVisible toggle). dailyQuizDefaultPublishTime
  // is "HH:MM" in IST (e.g. "07:00") — the default the admin's Create form
  // pre-fills; NEVER hard-coded elsewhere, and always overridable per day.
  dailyQuizEnabled            Boolean  @default(false)
  dailyQuizDefaultPublishTime String   @default("07:00")

  // Brain Challenge (finalized requirement) — separate Coming-Soon toggle
  // and default publish time from Daily Quiz's own, since the two are
  // independent content offerings that could go live on different
  // schedules (e.g. Daily Quiz already live, Brain Challenge still being
  // prepared) even though they share the same page and question-flow UI.
  brainChallengeEnabled            Boolean @default(false)
  brainChallengeDefaultPublishTime String  @default("07:00")

  // Subject & Topic Preference — Stage 2 (finalized requirement,
  // "Preference-based Question Allocation"). The percentage of a
  // session's non-Current-Affairs slots reserved for the student's
  // preferred Subjects/Topics before falling back to the general
  // eligible pool — configurable here, never hard-coded, so this can be
  // tuned (or later swapped for a performance-based Adaptive Practice
  // weight) without a code change. Only ever used when the student has
  // saved a preference for their current exam; has zero effect otherwise.
  subjectTopicPreferenceWeightPercent Int @default(75)

  // Ask Ponna — Personal AI Study & Exam Assistant (finalized requirement,
  // Specification v3, Phase 1 — Gemini as initial provider). Same
  // Coming-Soon-toggle pattern as Daily Quiz/Brain Challenge —
  // askPonnaEnabled defaults false so it's invisible until explicitly
  // switched on post-deploy testing (Spec v2 §14, Stage 1).
  //
  // askPonnaProvider/askPonnaModel document EXACTLY which provider/model
  // is live (Spec v3 §7's "document the exact model/version" requirement)
  // — read by the Orchestrator to pick which ProviderAdapter to
  // instantiate, never hard-coded in any other file (Spec v3 §1.3).
  //
  // askPonnaDailyLimitFree/Paid (finalized requirement — "Gemini free-tier
  // limits must NOT be treated as unlimited") are PONNA's own per-student
  // caps, deliberately set conservatively below Google's own free-tier
  // daily-request ceiling (roughly 500-1500 requests/day platform-wide on
  // Gemini's Flash-Lite free tier as of writing) so normal usage across
  // many students never collectively trips Google's hard block — pure
  // configuration, changeable here without any code/architecture change.
  askPonnaEnabled          Boolean @default(false)
  askPonnaProvider         String  @default("gemini")
  askPonnaModel            String  @default("gemini-2.5-flash-lite")
  askPonnaDailyLimitFree   Int     @default(0)
  askPonnaDailyLimitPaid   Int     @default(20)

  updatedAt                   DateTime @updatedAt
}
